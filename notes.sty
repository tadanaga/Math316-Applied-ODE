\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notes}[2026/11/22 Shared lecture notes theme]

%======================================================================
% QUICK START
%======================================================================
% Standard margins:   \usepackage{notes}
% Annotation margin:  \usepackage[widemargin]{notes}
%
% Use only one of these lines. No separate geometry line is needed.
% Do not add \normalmargin, \lecturemargin, or \notesmargin commands.
% Intended workflow: metadata-enabled documents compiled with recent
% LuaLaTeX. Keep \DocumentMetadata BEFORE \documentclass in each .tex file.
% The stylesheet cannot activate document metadata after the class loads.
% Native lists and sectioning avoid enumitem/enumerate/titlesec conflicts.
% Compilation alone does not certify PDF/UA compliance: figures, tables,
% math, and custom boxes still need document-level accessibility checks.
%
% Example document:
%   \DocumentMetadata{
%     tagging=on,
%     tagging-setup={math/setup=mathml-SE},
%     pdfstandard=ua-2,
%     lang=en-US
%   }
%   \documentclass[10pt,letterpaper]{article}
%   \usepackage[widemargin]{notes}
%   \hypersetup{pdftitle={Introduction},pdfauthor={Your Name}}
%   \begin{document}
%   \lesson{Day 1}{Introduction}
%   Your content.
%   \end{document}

%======================================================================
% 1. PERSONALIZATION -- EDIT THESE DEFAULTS WHEN SHARING THE TEMPLATE
%======================================================================
% Override the course/instructor/lesson text below with \renewcommand
% AFTER \usepackage{notes} and BEFORE \begin{document}.
% These settings control visible text; set PDF title/author separately
% with \hypersetup in the document.
% Example: \renewcommand{\instructor}{Your Name}
%----------------------------------------------------------------------
\newcommand{\class}{Math 316}
\newcommand{\coursename}{Applied ODE}
\newcommand{\term}{Fall 2026}
\newcommand{\instructor}{T. Takahashi}

% Running-header text; \lesson sets these automatically.
\newcommand{\lessonid}{}
\newcommand{\lessontitle}{}

%----------------------------------------------------------------------
% Margin dimensions (measured from the paper edge).
% Edit these defaults HERE, before geometry reads them.
% The widemargin option changes the left margin and keeps it on the
% physical left side in two-sided documents.
%----------------------------------------------------------------------
\newcommand{\notesstandardmargin}{0.7in}
\newcommand{\notesannotationmargin}{2.2in}
\newcommand{\notestopmargin}{1in}
\newcommand{\notesbottommargin}{1in}

%======================================================================
% 2. PACKAGE OPTION AND PAGE LAYOUT
%======================================================================
\newif\ifnoteswidemargin
\DeclareOption{widemargin}{\noteswidemargintrue}
\ProcessOptions\relax

\@ifpackageloaded{geometry}{%
  \geometry{headheight=23pt,headsep=16pt,footskip=26pt}%
}{%
  \RequirePackage[
    left=\notesstandardmargin,right=\notesstandardmargin,
    top=\notestopmargin,bottom=\notesbottommargin,
    headheight=23pt,headsep=16pt,footskip=26pt
  ]{geometry}%
}
\ifnoteswidemargin
  \geometry{left=\notesannotationmargin,asymmetric}
\fi
% Preserve explicit geometry settings in existing lesson files.
% For new documents, let notes load geometry and manage the margins.

%======================================================================
% 3. FONTS AND DEPENDENCIES
%======================================================================
% Dependencies retained for existing course content, not a claim that
% every environment they provide has been validated for PDF tagging.
%----------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage{charter}
\RequirePackage[scaled=0.92]{helvet}
\RequirePackage{microtype}

%---- Mathematics -----------------------------------------------------
\RequirePackage{amsmath,amsthm,amssymb,mathtools,bm,cancel}
%---- Figures and tables ----------------------------------------------
\RequirePackage{graphicx,float,multicol,multirow,tabularx,array,booktabs,subcaption,wrapfig}
%---- Colors, headers, and page references -----------------------------
\RequirePackage{xcolor,fancyhdr,lastpage,needspace}
%---- Native lists and headings ---------------------------------------
% Do not load enumerate, enumitem, or titlesec here.
% Use standard itemize/enumerate and the native section commands below.
% Dependencies used by existing Math 316 lessons.
\RequirePackage{physics,gensymb,wasysym,circuitikz,parcolumns,textcomp}
% Preserve the standard meaning of \emph.
\RequirePackage[normalem]{ulem}
%---- Drawing and plots -----------------------------------------------
\RequirePackage{tikz,pgfplots,tikz-3dplot}
\RequirePackage[most]{tcolorbox}
\RequirePackage{xparse,ifthen,pifont}
\usetikzlibrary{3d,arrows.meta,calc,angles,quotes,shapes.geometric,positioning,
  decorations.pathreplacing,decorations.markings,calligraphy}
\usepgfplotslibrary{groupplots}
\pgfplotsset{compat=1.17}
% hyperref is loaded here; documents need only \hypersetup for metadata.
\RequirePackage{hyperref}

%======================================================================
% 4. COLOR THEME -- EDIT THESE COLORS TO PERSONALIZE THE LOOK
%======================================================================
% A small shared palette; change these colors to restyle all environments.
\definecolor{notesink}{HTML}{203448}
\definecolor{notesblue}{HTML}{245C7A}
\definecolor{notesteal}{HTML}{237A73}
\definecolor{notesgold}{HTML}{95611C}
\definecolor{notesmuted}{HTML}{5A6570}
\definecolor{notesrule}{HTML}{D7DFE5}
\definecolor{dgreen}{HTML}{237A73}
\colorlet{exampleaccent}{notesblue}
\colorlet{exampleborder}{notesrule}
\colorlet{examplebg}{notesblue!3}
\colorlet{commentblue}{notesblue}
\hypersetup{colorlinks=true,linkcolor=notesblue,urlcolor=notesteal}

%======================================================================
% 5. FIGURE CAPTIONS
%======================================================================
% Consistent captions for numbered figures. A visible caption does not
% replace alternative text for a diagram or image.
% The float package above supports [H] for placement at the source location.
% subcaption loads caption, so no additional caption package is necessary.
\DeclareCaptionFont{notesfigurelabel}{\bfseries\color{notesblue}}
\DeclareCaptionFont{notesfiguretext}{\color{notesmuted}}
\captionsetup[figure]{%
  font=small,
  labelfont=notesfigurelabel,
  textfont=notesfiguretext,
  labelsep=period,
  justification=centering,
  singlelinecheck=false,
  skip=6pt,
  position=bottom
}


%======================================================================
% 6. SOLUTION VISIBILITY AND WRITING SPACE
%======================================================================
% After loading notes, use \setboolean{showanswer}{false} to hide
% example solutions and \answer content. Other text is not hidden.
\newboolean{showanswer}
\setboolean{showanswer}{true}

% Blank height in each example when its solution is hidden.
% Override with \renewcommand{\solutionheight}{30mm}, for example.
% The older ans/note list environments are NOT controlled by showanswer.
\newcommand{\solutionheight}{24mm}
%======================================================================
% 7. PARAGRAPHS, LISTS, AND SECTION HEADINGS
%======================================================================
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt}
\renewcommand{\arraystretch}{1.18}
\raggedbottom

%---- Native lists ----------------------------------------------------
% Standard itemize and enumerate require no additional packages.
% Leave spacing/labels to LaTeX's tagging-aware list implementation.
% For custom labels, use \item[(a)] rather than legacy [a)] list options.
%
%---- Native section headings -----------------------------------------
% Keep LaTeX's \@startsection pathway for numbered/starred headings,
% contents entries, and tagging. Do not redefine \@sect or \@ssect.
% Large ink section titles and blue subsections retain the hierarchy.
% The former titlesec rule and separately colored numbers are omitted.
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-13pt}{7pt}{\normalfont\LARGE\bfseries\color{notesink}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-9pt}{3pt}{\normalfont\normalsize\bfseries\color{notesblue}}}

%======================================================================
% 8. RUNNING HEADERS, FOOTERS, AND LESSON TITLE
%======================================================================
\fancypagestyle{pages}{%
  \fancyhf{}
  \fancyhead[L]{\small\sffamily\color{notesmuted}\class\enspace /\enspace\coursename}
  \fancyhead[R]{\small\sffamily\color{notesmuted}\lessonid\enspace\lessontitle}
  \fancyfoot[L]{\footnotesize\color{notesmuted}\instructor\enspace\textbullet\enspace\term}
  \fancyfoot[R]{\footnotesize\color{notesmuted}\thepage\ /\ \pageref*{LastPage}}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0pt}
  \renewcommand{\headrule}{\hbox to\headwidth{\color{notesrule}\leaders\hrule height\headrulewidth\hfill}}
}
\pagestyle{pages}

%---- Visible lesson title --------------------------------------------
% \lesson[reference or subtitle]{day/number}{title} sets running headers.
% This display is not a numbered section and does not set PDF metadata.
\NewDocumentCommand{\lesson}{O{} m m}{%
  \renewcommand{\lessonid}{#2}\renewcommand{\lessontitle}{#3}%
  \vspace{3pt}
  {\fontsize{25}{30}\selectfont\bfseries\color{notesink}#2\enspace #3\par}
  \IfBlankF{#1}{{\small\color{notesmuted}#1\par}}
  \vspace{5pt}{\color{notesteal}\hrule height 1.2pt}\vspace{8pt}
}

%======================================================================
% 9. TEACHING BOXES
%======================================================================
% Optional titles: \begin{definition}[Title], \begin{keyidea}[Title], etc.
% Shared visual settings; titles distinguish boxes without relying on color.
% Preserve existing syntax and appearance. Check reading order and tags
% for these custom tcolorbox environments in the final PDF.
\tcbset{notesbox/.style={enhanced,breakable,sharp corners,boxrule=0pt,
  frame hidden,borderline west={2pt}{0pt}{notesblue},colback=notesblue!4,
  coltitle=notesblue,fonttitle=\small\sffamily\bfseries,
  attach title to upper={\par\smallskip},left=10pt,right=10pt,top=6pt,bottom=6pt,
  before skip=6pt,after skip=6pt}}
  
\newtcolorbox{learninggoals}{notesbox,colback=notesteal!4,
  borderline west={2pt}{0pt}{notesteal},coltitle=notesteal,title=Learning goals}

\newtcolorbox{definition}[1][]{notesbox,
  title={Definition\IfBlankF{#1}{\enspace /\enspace #1}}}

\newtcolorbox{keyidea}[1][]{notesbox,colback=notesteal!5,
  borderline west={2pt}{0pt}{notesteal},coltitle=notesteal,
  title={Key idea\IfBlankF{#1}{\enspace /\enspace #1}}}

\newtcolorbox{commonmistake}[1][]{notesbox,colback=notesgold!6,
  borderline west={2pt}{0pt}{notesgold},coltitle=notesgold,
  title={Watch out\IfBlankF{#1}{\enspace /\enspace #1}}}

\newtcolorbox{checkpoint}[1][]{notesbox,colback=white,
  borderline west={2pt}{0pt}{notesmuted},coltitle=notesink,
  title={Quick check\IfBlankF{#1}{\enspace /\enspace #1}}}

\newtcolorbox{takeaway}{notesbox,colback=notesteal!4,
  borderline west={2pt}{0pt}{notesteal},coltitle=notesteal,title=Takeaway}

%======================================================================
% 10. EXAMPLES, ANSWERS, AND THEOREMS
%======================================================================
% Usage: \begin{example}[label]{problem} solution \end{example}
% An omitted label displays the automatic example counter.
% Each example advances the counter, including explicitly labeled ones.
% showanswer controls the solution body, not the problem statement.
\newcounter{example}
\NewDocumentEnvironment{example}{O{} +m +b}{%
  \refstepcounter{example}%
  \begin{tcolorbox}[notesbox,colback=white,boxrule=0.5pt,frame hidden=false,
    colframe=notesrule,borderline west={2pt}{0pt}{exampleaccent},
    borderline north={0.6pt}{0pt}{notesrule},
    borderline south={0.6pt}{0pt}{notesrule},
    title={Example\enspace\IfBlankTF{#1}{\theexample}{#1}},
    segmentation style={solid,notesrule}]
    #2
    \tcblower
    \ifthenelse{\boolean{showanswer}}{%
      \textcolor{notesteal}{\textbf{Solution.}} #3
    }{\textcolor{notesmuted}{\small Work space}\par\vspace{\solutionheight}}
  \end{tcolorbox}
}{}
%---- Answers and work space ------------------------------------------
% \answer{...} content disappears when showanswer is false.
% Keep the question outside \answer so it remains visible.
\NewDocumentCommand{\answer}{+m}{%
  \ifthenelse{\boolean{showanswer}}{\par\smallskip\textcolor{notesteal}{\textbf{Answer.}} #1}{}%
}
\NewDocumentCommand{\workingspace}{O{18mm}}{\par\vspace{#1}}
\newtheorem{theorem}{Theorem}

%======================================================================
% 11. SHORTCUTS RETAINED FOR EXISTING LESSONS
%======================================================================
%---- Colored lists and text ------------------------------------------
% ans and note are ordinary lists with color; neither hides its content.
% \com{...} is a textual annotation intended for math environments.
\newenvironment{ans}{\begin{itemize}\color{notesblue}}{\end{itemize}}
\newenvironment{note}{\begin{itemize}\color{notesgold}}{\end{itemize}}
\newcommand{\com}[1]{\textcolor{commentblue}{\text{(#1)}}}
\newcommand{\red}[1]{\textcolor{red}{#1}}
\newcommand{\green}[1]{\textcolor{green}{#1}}
\newcommand{\blue}[1]{\textcolor{notesblue}{#1}}
%---- Mathematical notation -------------------------------------------
% \cvec{a,b} produces angle brackets; \vec uses an over-arrow.
\newcommand{\B}[1]{\mathbf{#1}}
\newcommand{\ve}[1]{\mathbf{#1}}
\newcommand{\xmark}{\ding{55}}
\newcommand{\cvec}[1]{\left\langle #1\right\rangle}
\DeclareMathOperator{\sgn}{sgn}
\let\Re\relax \let\Im\relax
\DeclareMathOperator{\Re}{Re}
\DeclareMathOperator{\Im}{Im}
\newcommand{\mySpacing}{0.295}
\let\oldvec\vec
\renewcommand{\vec}[1]{\overrightarrow{#1}}
%---- Two columns -----------------------------------------------------
% Usage: \cols{left content}{right content}
% These minipages do not split across pages. Keep content short and
% check that the PDF reading order follows the left column, then right.
\NewDocumentCommand{\cols}{+m +m}{%
  \par\noindent
  \begin{minipage}[t]{0.47\linewidth}\vspace{0pt}#1\end{minipage}\hfill
  \begin{minipage}[t]{0.47\linewidth}\vspace{0pt}#2\end{minipage}\par
}
\endinput
