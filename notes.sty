% Two columns with a vertical divider
\NewDocumentCommand{\cols}{+m +m}{%
    \par\noindent
    \begin{minipage}[t]{0.46\textwidth}
        \vspace{0pt}
        #1
    \end{minipage}%
    \hfill
    \vrule width 0.4pt
    \hfill
    \begin{minipage}[t]{0.46\textwidth}
        \vspace{0pt}
        #2
    \end{minipage}%
    \par
}
